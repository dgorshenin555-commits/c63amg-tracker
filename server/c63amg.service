[Unit]
Description=C63AMG Polymarket Paper Tracker (virtual only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=c63amg
Group=c63amg
WorkingDirectory=/var/lib/c63amg
EnvironmentFile=-/etc/c63amg.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/c63amg-tracker/server/runner.py
Restart=always
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/c63amg
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
